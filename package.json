{
  "name": "fitness-assessment-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "종합 체력평가 시스템 (ACSM · NSCA · NASM · FMS)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev --name init",
    "setup:local": "bash scripts/setup-local.sh",
    "postinstall": "prisma generate",
    "vercel-build": "rm -rf node_modules/.prisma && prisma generate && prisma db push && next build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "html-to-image": "^1.11.13",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
