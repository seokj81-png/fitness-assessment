// Prisma schema for Fitness Assessment System
// Guidelines: ACSM · NSCA · NASM · FMS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id          String   @id @default(cuid())
  name        String
  sex         String   // "M" | "F"
  dob         DateTime?
  height      Float?   // cm
  weight      Float?   // kg (현재 체중)
  occupation  String?
  smoking     String?  // "no" | "ex" | "yes"
  experience  String?  // "none" | "beginner" | "intermediate" | "advanced"
  goal        String?  // "health" | "weight" | "strength" | "performance" | "rehab"
  medical     String?  // 의료 이력, 복용 약물, 통증 부위 등
  branch      String?  // 지점 (도곡, 도곡 라이프, 개포1, 개포2, 대치, 한남, 서초 등)
  trainer     String?  // 담당 트레이너
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assessments Assessment[]
  inbodyEntries InbodyEntry[]
}

// 인바디 수시 기록 — 평가와 독립적으로 자주(월 2회 등) 측정·누적
model InbodyEntry {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  weight    Float?   // 체중 kg
  bodyFat   Float?   // 체지방률 %
  smm       Float?   // 골격근량 kg
  createdAt DateTime @default(now())

  @@index([clientId, date])
}

model Assessment {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  assessor   String?

  // PAR-Q+ (JSON array of 7 boolean answers)
  parq       String?  // JSON: boolean[]

  // Vitals
  rhr        Int?
  sbp        Int?
  dbp        Int?

  // Body composition
  height     Float?   // cm (측정 시점, 없으면 회원 프로필 값 사용)
  weight     Float?   // kg (측정 시점, 없으면 회원 프로필 값 사용)
  bmi        Float?
  waist      Float?
  hip        Float?
  sf1        Float?   // mm
  sf2        Float?
  sf3        Float?
  bodyFatSf  Float?   // % (skinfold)
  biaBf      Float?   // BIA 체지방률
  biaSmm     Float?   // 골격근량
  biaFm      Float?   // 체지방량
  biaFfm     Float?   // 제지방량
  biaBmr     Float?   // 기초대사량
  biaTbw     Float?   // 체수분

  // Cardiorespiratory
  rockportTime Float?  // minutes
  rockportHr   Int?
  run15Time    Float?
  run5minDist  Int?    // 5-min run test distance (m) → Riegel 2.4km prediction
  cooperDist   Int?    // meters
  stepHr       Int?
  vo2max       Float?

  // Strength – 1RM (kg)
  bp1rm      Float?
  sq1rm      Float?
  dl1rm      Float?
  ohp1rm     Float?
  pc1rm      Float?
  lp1rm      Float?
  gripR      Float?
  gripL      Float?
  est1rmW    Float?
  est1rmReps Int?

  // Endurance
  pushupReps   Int?
  ymcaBpReps   Int?
  curlupReps   Int?
  squatReps    Int?   // 스쿼트 지구력 테스트 (하지 근지구력)
  pullupReps   Int?   // 풀업 테스트 (상체 당기기 근지구력)
  plankFront   Int?   // seconds
  plankR       Int?
  plankL       Int?
  sorensen     Int?

  // Posture flags (JSON array of string keys)
  postureFlags String? // JSON: string[]
  postureMemo    String? // 자세 질적 평가 메모
  postureDrawing String? // 체형 스케치 (PNG dataURL, 그림 레이어만)
  posturePhotos  String? // 자세 사진 첨부 (JSON: dataURL[], 최대 4장 압축 JPEG)

  // 호흡 평가 — FMS Breathing Screen (Kiesel et al. 2016)
  breathFrc   Int?    // FRC 숨참기 (초) — 일반 호기 후
  breathTlc   Int?    // TLC 숨참기 (초) — 최대 흡기 후
  breathHiLo  String? // Hi-Lo 관찰: "diaph" | "thoracic" | "paradox"
  breathQ     String? // JSON: number[4] — 4문항 각 0-3 (긴장/손발참/하품/야간 구강호흡)

  // FMS scores (JSON: Record<string,number>)
  fms          String? // JSON: {dsq, hs_r, hs_l, lu_r, lu_l, sm_r, sm_l, aslr_r, aslr_l, tsp, rs_r, rs_l}
  clearSh      String? // "neg" | "pos"
  clearExt     String? // "neg" | "pos"
  clearFlex    String? // "neg" | "pos"

  // NASM OHSA / extra movement screens (JSON array of string keys)
  ohsaFlags    String? // JSON: string[]

  // ROM (JSON: Record<string,number>)
  rom          String? // JSON

  // FMS per-test comments (JSON: Record<string,string>)
  fmsComments  String?

  // Notes
  notes        String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
  @@index([date])
}
